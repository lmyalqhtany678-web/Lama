<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>رحلة إلى الفضاء 🚀</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Orbitron:wght@500;700&display=swap');

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: "Cairo", sans-serif;
    background: #02030d;
    color: white;
    overflow: hidden;
}

/* ===== BACKGROUND ===== */

.space {
    position: fixed;
    inset: 0;
    background:
        radial-gradient(circle at 20% 20%, rgba(85,70,180,.22), transparent 25%),
        radial-gradient(circle at 80% 70%, rgba(0,150,255,.14), transparent 25%),
        linear-gradient(135deg, #02030d, #070b20 50%, #02030d);
    z-index: -3;
}

.stars,
.stars2,
.stars3 {
    position: fixed;
    inset: 0;
    background-repeat: repeat;
    z-index: -2;
}

.stars {
    background-image:
        radial-gradient(2px 2px at 20px 30px, white, transparent),
        radial-gradient(1px 1px at 90px 80px, white, transparent),
        radial-gradient(2px 2px at 150px 150px, white, transparent),
        radial-gradient(1px 1px at 250px 40px, white, transparent),
        radial-gradient(2px 2px at 350px 180px, white, transparent);
    background-size: 400px 250px;
    animation: starsMove 25s linear infinite;
}

.stars2 {
    opacity: .6;
    background-image:
        radial-gradient(1px 1px at 40px 70px, #9edcff, transparent),
        radial-gradient(2px 2px at 170px 120px, #fff, transparent),
        radial-gradient(1px 1px at 300px 200px, #b9aaff, transparent);
    background-size: 500px 300px;
    animation: starsMove 40s linear infinite reverse;
}

.stars3 {
    opacity: .35;
    background-image:
        radial-gradient(1px 1px at 100px 50px, white, transparent),
        radial-gradient(1px 1px at 400px 250px, white, transparent);
    background-size: 600px 400px;
}

@keyframes starsMove {
    from { transform: translateY(0); }
    to { transform: translateY(250px); }
}

/* ===== PRESENTATION ===== */

.presentation {
    width: 100vw;
    height: 100vh;
    position: relative;
}

.slide {
    position: absolute;
    inset: 0;
    padding: 70px 8% 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: translateX(70px) scale(.97);
    pointer-events: none;
    transition: .7s ease;
}

.slide.active {
    opacity: 1;
    transform: translateX(0) scale(1);
    pointer-events: auto;
}

.content {
    width: min(1150px, 100%);
    position: relative;
}

h1 {
    font-size: clamp(45px, 8vw, 100px);
    line-height: 1.05;
    margin-bottom: 20px;
}

h2 {
    font-size: clamp(32px, 5vw, 60px);
    margin-bottom: 25px;
}

p {
    color: #ccd5ff;
    font-size: clamp(16px, 2vw, 21px);
    line-height: 2;
}

.highlight {
    color: #83d8ff;
}

.subtitle {
    color: #aeb9e8;
    font-size: 20px;
}

/* ===== COVER ===== */

.cover {
    text-align: center;
}

.cover h1 {
    font-family: "Orbitron", sans-serif;
    text-shadow:
        0 0 20px #5bc8ff,
        0 0 50px rgba(70,130,255,.6);
}

.cover .subtitle {
    margin: 20px auto 35px;
}

.start-btn {
    padding: 15px 35px;
    border: 1px solid #71d8ff;
    border-radius: 50px;
    background: rgba(80,180,255,.1);
    color: white;
    font-size: 17px;
    cursor: pointer;
    transition: .3s;
}

.start-btn:hover {
    background: #71d8ff;
    color: #02030d;
    box-shadow: 0 0 30px #71d8ff;
}

/* ===== PLANET ===== */

.planet {
    width: 210px;
    height: 210px;
    border-radius: 50%;
    margin: 30px auto;
    position: relative;
    box-shadow:
        inset -30px -20px 50px rgba(0,0,0,.7),
        0 0 50px rgba(100,180,255,.4);
    cursor: pointer;
    transition: .4s;
}

.planet:hover {
    transform: scale(1.08) rotate(8deg);
}

.earth {
    background:
        radial-gradient(circle at 35% 35%, #8ce8ff 0 8%, transparent 9%),
        radial-gradient(circle at 65% 45%, #49bd6b 0 10%, transparent 11%),
        radial-gradient(circle at 45% 70%, #318e55 0 12%, transparent 13%),
        linear-gradient(135deg, #1e67cf, #071d75);
}

.moon {
    background:
        radial-gradient(circle at 30% 30%, #aaa 0 8%, transparent 9%),
        radial-gradient(circle at 65% 60%, #888 0 7%, transparent 8%),
        linear-gradient(135deg, #ddd, #555);
}

.sun {
    width: 260px;
    height: 260px;
    border-radius: 50%;
    background: radial-gradient(circle, #fff3a0, #ffb300 45%, #ff5c00 75%);
    box-shadow:
        0 0 40px #ffbf35,
        0 0 100px rgba(255,120,0,.7);
    animation: sunPulse 3s infinite alternate;
    margin: 20px auto;
}

@keyframes sunPulse {
    to {
        transform: scale(1.04);
        box-shadow:
            0 0 60px #ffbf35,
            0 0 130px rgba(255,120,0,.8);
    }
}

/* ===== CARDS ===== */

.cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-top: 25px;
}

.card {
    padding: 22px;
    border-radius: 22px;
    border: 1px solid rgba(150,190,255,.2);
    background: rgba(255,255,255,.055);
    backdrop-filter: blur(12px);
    transition: .3s;
}

.card:hover {
    transform: translateY(-8px);
    background: rgba(120,170,255,.12);
    border-color: rgba(120,210,255,.6);
}

.card h3 {
    margin-bottom: 8px;
    color: #8cddff;
}

.card p {
    font-size: 14px;
    line-height: 1.7;
}

/* ===== PLANETS GRID ===== */

.planets {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-top: 20px;
}

.planet-card {
    padding: 17px 10px;
    text-align: center;
    border-radius: 20px;
    background: rgba(255,255,255,.05);
    border: 1px solid rgba(255,255,255,.1);
    transition: .3s;
    cursor: pointer;
}

.planet-card:hover {
    transform: translateY(-7px) scale(1.03);
    border-color: #77d9ff;
}

.mini-planet {
    width: 65px;
    height: 65px;
    margin: auto auto 10px;
    border-radius: 50%;
    box-shadow: inset -10px -8px 15px rgba(0,0,0,.5);
}

.mercury { background: #777; }
.venus { background: #d99b54; }
.earth2 { background: #2377d5; }
.mars { background: #c54f36; }
.jupiter { background: #c79a72; }
.saturn { background: #d8bd78; }
.uranus { background: #75d8df; }
.neptune { background: #3154d9; }

.planet-card h3 {
    font-size: 16px;
}

.planet-card small {
    color: #9ba8d0;
}

/* ===== BLACK HOLE ===== */

.blackhole {
    width: 260px;
    height: 260px;
    border-radius: 50%;
    margin: 25px auto;
    background: #000;
    box-shadow:
        0 0 25px #ff7b00,
        0 0 55px #ff3c00,
        0 0 100px rgba(255,90,0,.5);
    position: relative;
}

.blackhole::before {
    content: "";
    position: absolute;
    inset: -25px;
    border: 14px solid transparent;
    border-top-color: #ff8b00;
    border-bottom-color: #ff3c00;
    border-radius: 50%;
    animation: spin 3s linear infinite;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

/* ===== FACTS ===== */

.fact {
    text-align: center;
    padding: 35px;
    border-radius: 30px;
    background: linear-gradient(
        135deg,
        rgba(100,90,255,.12),
        rgba(30,180,255,.08)
    );
    border: 1px solid rgba(130,200,255,.2);
}

.fact-number {
    font-size: 70px;
    font-family: "Orbitron";
    color: #83ddff;
    text-shadow: 0 0 30px #43baff;
}

/* ===== ASTRONAUT ===== */

.astronaut {
    font-size: 130px;
    text-align: center;
    animation: float 4s ease-in-out infinite;
    filter: drop-shadow(0 0 20px rgba(150,210,255,.5));
}

@keyframes float {
    0%,100% { transform: translateY(0) rotate(-3deg); }
    50% { transform: translateY(-25px) rotate(3deg); }
}

/* ===== NAVIGATION ===== */

.navigation {
    position: fixed;
    bottom: 25px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 15px;
    z-index: 20;
}

.nav-btn {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid rgba(150,220,255,.4);
    background: rgba(5,10,30,.75);
    color: white;
    cursor: pointer;
    font-size: 20px;
    transition: .3s;
}

.nav-btn:hover {
    background: #70d7ff;
    color: #02030d;
    box-shadow: 0 0 20px #70d7ff;
}

.progress {
    min-width: 110px;
    text-align: center;
    font-family: "Orbitron";
    color: #b8caff;
}

.progress-bar {
    width: 110px;
    height: 3px;
    background: rgba(255,255,255,.15);
    margin-top: 7px;
    border-radius: 10px;
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    width: 9%;
    background: #70d7ff;
    box-shadow: 0 0 10px #70d7ff;
    transition: .5s;
}

/* ===== TOP LABEL ===== */

.top-label {
    position: fixed;
    top: 20px;
    right: 30px;
    font-family: "Orbitron";
    font-size: 13px;
    color: #8da9d8;
    z-index: 20;
}

/* ===== RESPONSIVE ===== */

@media(max-width: 800px) {

    .slide {
